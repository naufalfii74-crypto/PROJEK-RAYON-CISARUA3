---
// Footer Component
const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-slate text-white py-12 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-6 pb-8 border-b border-slate-800">

            <!-- Brand Info -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-brand-orange flex items-center justify-center font-extrabold text-xl text-white shadow-md">
                    RC
                </div>
                <div>
                    <span class="font-display font-extrabold text-xl tracking-tight text-white block leading-none">
                        Rayon Cisarua 3<span class="text-brand-orange">.</span>
                    </span>
                    <span class="text-xs text-slate-400">Media Komunikasi &amp; Portal Informasi Resmi Siswa</span>
                </div>
            </div>

            <!-- Class Info -->
            <div class="text-center md:text-right text-xs text-slate-400 space-y-1">
                <p class="font-medium text-slate-300">SMK Wikrama Bogor &bull; Wilayah Cisarua</p>
                <p>Pembimbing: Mohamad Rizal S.Pd</p>
            </div>

        </div>

        <div class="pt-8 text-center text-xs text-slate-500">
            <p>&copy; {currentYear} Rayon Cisarua 3. All rights reserved.</p>
        </div>
    </div>
</footer>
