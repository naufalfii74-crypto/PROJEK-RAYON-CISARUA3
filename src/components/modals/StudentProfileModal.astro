---
// Student Profile Modal — shown when clicking any student card in the list
---

<div id="student-profile-modal" class="fixed inset-0 z-50 hidden modal-backdrop flex items-center justify-center p-4">
  <div class="relative max-w-md w-full bg-white rounded-3xl shadow-2xl border border-slate-100 overflow-hidden transform transition-all">

    <!-- Header gradient banner -->
    <div class="h-28 bg-gradient-to-br from-brand-orange via-orange-500 to-amber-600 relative">
      <button id="sp-close-btn" class="absolute top-4 right-4 w-8 h-8 bg-white/20 hover:bg-white/40 text-white rounded-full flex items-center justify-center transition-colors">
        <i class="fas fa-times text-sm"></i>
      </button>
    </div>

    <!-- Avatar overlapping banner -->
    <div class="flex flex-col items-center -mt-14 px-6 pb-6">
      <div class="relative mb-3">
        <img
          id="sp-photo"
          src=""
          alt="Foto Profil"
          class="w-24 h-24 rounded-full object-cover border-4 border-white shadow-lg"
        >
        <!-- Online indicator -->
        <span class="absolute bottom-1 right-1 w-4 h-4 bg-emerald-400 border-2 border-white rounded-full"></span>
      </div>

      <h3 id="sp-fullname" class="font-display font-extrabold text-xl text-brand-slate text-center leading-tight"></h3>

      <div class="flex items-center gap-2 mt-2 flex-wrap justify-center">
        <span id="sp-role" class="text-xs font-semibold text-brand-orange bg-brand-warm px-3 py-1 rounded-full border border-brand-light"></span>
        <span id="sp-angkatan-badge" class="text-xs font-medium text-slate-500 bg-slate-100 px-3 py-1 rounded-full border border-slate-200"></span>
      </div>

      <!-- Details -->
      <div class="w-full mt-5 space-y-2.5 text-sm">
        <div class="flex justify-between items-center py-2 border-b border-slate-100">
          <span class="text-brand-muted flex items-center gap-2"><i class="fas fa-id-card text-brand-orange text-xs w-4"></i> NIS</span>
          <span id="sp-nis" class="font-mono font-bold text-brand-slate"></span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-slate-100">
          <span class="text-brand-muted flex items-center gap-2"><i class="fas fa-graduation-cap text-brand-orange text-xs w-4"></i> Jurusan</span>
          <span id="sp-major" class="font-semibold text-brand-slate text-right max-w-[55%]"></span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-slate-100">
          <span class="text-brand-muted flex items-center gap-2"><i class="fas fa-users text-brand-orange text-xs w-4"></i> Rayon</span>
          <span class="font-bold text-brand-orange">Cisarua 3</span>
        </div>
        <div class="flex justify-between items-center py-2">
          <span class="text-brand-muted flex items-center gap-2"><i class="fas fa-star text-brand-orange text-xs w-4"></i> Angkatan</span>
          <span id="sp-angkatan" class="font-bold text-brand-slate"></span>
        </div>
      </div>

      <!-- Achievements section -->
      <div id="sp-achievements-section" class="w-full mt-5 hidden">
        <h4 class="font-display font-bold text-sm text-brand-slate mb-3 flex items-center gap-2">
          <i class="fas fa-trophy text-amber-500"></i> Capaian Prestasi
        </h4>
        <div id="sp-achievements-list" class="space-y-2"></div>
      </div>

      <!-- Close button -->
      <button id="sp-close-bottom-btn" class="mt-6 w-full bg-slate-100 hover:bg-slate-200 text-brand-slate font-semibold py-2.5 rounded-xl text-sm transition-colors">
        Tutup
      </button>
    </div>
  </div>
</div>
