---
// Student Dashboard / Profile Portal View Modal
---

<div id="dashboard-modal" class="fixed inset-0 z-50 hidden bg-brand-bg overflow-y-auto">
    <!-- Top Navigation -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">

                <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-brand-orange text-white flex items-center justify-center font-bold text-sm">
                        RC
                    </div>
                    <div>
                        <span class="font-display font-bold text-brand-slate text-base">Portal Siswa</span>
                        <span class="text-xs text-brand-muted hidden sm:inline-block ml-2 border-l border-slate-200 pl-2">Rayon Cisarua 3</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-2 pr-2 border-r border-slate-200">
                        <img id="dash-user-avatar" src="" alt="Avatar" class="w-8 h-8 rounded-full border border-brand-orange object-cover">
                        <span id="dash-user-name" class="font-semibold text-xs sm:text-sm text-brand-slate hidden sm:inline-block">User Name</span>
                    </div>

                    <button id="logout-btn" class="text-xs bg-red-50 text-red-600 hover:bg-red-100 px-3 py-1.5 rounded-lg font-semibold transition-colors flex items-center gap-1.5">
                        <i class="fas fa-sign-out-alt"></i>
                        <span>Keluar</span>
                    </button>
                </div>

            </div>
        </div>
    </header>

    <!-- Main Body -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

        <!-- Welcome Banner -->
        <div class="bg-gradient-to-r from-brand-orange via-orange-600 to-amber-700 rounded-3xl p-6 sm:p-8 text-white shadow-xl mb-8 relative overflow-hidden">
            <div class="relative z-10">
                <span class="bg-white/20 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider mb-3 inline-block">
                    Profil Siswa Terverifikasi
                </span>
                <h2 class="font-display font-extrabold text-2xl sm:text-3xl mb-1">
                    Selamat Datang, <span id="dash-welcome-name">Siswa</span>! 👋
                </h2>
                <p class="text-orange-100 text-xs sm:text-sm max-w-2xl">
                    Akses profil pribadi, ganti foto profil Anda, dan pantau pengumuman Rayon Cisarua 3.
                </p>
            </div>
        </div>

        <div class="grid lg:grid-cols-12 gap-8">

            <!-- Student Profile Card & Photo Manager -->
            <div class="lg:col-span-5 space-y-6">
                <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-100 shadow-soft">

                    <div class="text-center pb-6 border-b border-slate-100">
                        <!-- Avatar Display & Edit Action -->
                        <div class="relative inline-block mb-4 group">
                            <img id="dash-card-avatar" src="" alt="Student Profile" class="w-28 h-28 rounded-full object-cover border-4 border-brand-warm mx-auto shadow-md">
                            <button id="avatar-edit-btn" class="absolute bottom-0 right-0 bg-brand-orange text-white w-9 h-9 rounded-full flex items-center justify-center shadow-lg hover:bg-brand-hover transition-transform hover:scale-110" title="Ubah Foto Profil">
                                <i class="fas fa-camera text-xs"></i>
                            </button>
                        </div>

                        <h3 id="dash-card-fullname" class="font-display font-bold text-xl text-brand-slate">Full Name</h3>
                        <div class="flex items-center justify-center gap-2 mt-2">
                            <span id="dash-card-role" class="text-xs font-semibold text-brand-orange bg-brand-warm px-3 py-1 rounded-full border border-brand-light">Role</span>
                            <span id="dash-card-admin-badge" class="hidden text-xs font-semibold text-purple-700 bg-purple-100 px-3 py-1 rounded-full border border-purple-200"><i class="fas fa-user-shield mr-1"></i> Admin Rayon</span>
                        </div>

                        <button id="avatar-change-link" class="mt-4 text-xs font-semibold text-brand-orange hover:underline flex items-center justify-center gap-1 mx-auto">
                            <i class="fas fa-image"></i>
                            <span>Ganti Foto Profil</span>
                        </button>
                    </div>

                    <!-- Profile Details -->
                    <div class="pt-6 space-y-3.5 text-xs sm:text-sm">
                        <div class="flex justify-between items-center py-1">
                            <span class="text-brand-muted">NIS</span>
                            <span id="dash-card-nis" class="font-mono font-bold text-brand-slate">12345678</span>
                        </div>
                        <div class="flex justify-between items-center py-1 border-t border-slate-50">
                            <span class="text-brand-muted">Kelas / Major</span>
                            <span id="dash-card-major" class="font-bold text-brand-slate">PPLG</span>
                        </div>
                        <div class="flex justify-between items-center py-1 border-t border-slate-50">
                            <span class="text-brand-muted">Rayon</span>
                            <span class="font-bold text-brand-orange">Cisarua 3</span>
                        </div>
                        <div class="flex justify-between items-center py-1 border-t border-slate-50">
                            <span class="text-brand-muted">Pembimbing Rayon</span>
                            <span class="font-semibold text-brand-slate">Ibu Rina Wulandari, S.Pd.</span>
                        </div>
                        <div class="flex justify-between items-center py-1 border-t border-slate-50">
                            <span class="text-brand-muted">Status Kehadiran</span>
                            <span class="font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded">Sangat Baik</span>
                        </div>
                    </div>

                </div>

                <!-- Admin Shortcut Options if applicable -->
                <div id="dash-admin-shortcut" class="hidden bg-purple-50 border border-purple-200 p-6 rounded-3xl">
                    <h4 class="font-display font-bold text-purple-900 text-sm mb-2 flex items-center gap-2">
                        <i class="fas fa-tools text-purple-600"></i>
                        Akses Pengurus Rayon
                    </h4>
                    <p class="text-xs text-purple-700 leading-relaxed mb-4">
                        Sebagai Pengurus Rayon, Anda memiliki wewenang untuk mengatur Jadwal Piket harian siswa Cisarua 3.
                    </p>
                    <button id="dash-piket-admin-btn" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2.5 px-4 rounded-xl text-xs transition-colors shadow">
                        Kelola Jadwal Piket Sekarang
                    </button>
                </div>
            </div>

            <!-- Personal Info & Announcements -->
            <div class="lg:col-span-7 space-y-6">

                <!-- Announcements -->
                <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-100 shadow-soft">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="font-display font-bold text-xl text-brand-slate flex items-center gap-2.5">
                            <span class="w-8 h-8 rounded-lg bg-orange-100 text-brand-orange flex items-center justify-center text-sm">
                                <i class="fas fa-bell"></i>
                            </span>
                            Pengumuman Rayon
                        </h3>
                        <span class="text-xs bg-orange-50 text-brand-orange px-2.5 py-1 rounded-md font-semibold border border-brand-light">Penting</span>
                    </div>

                    <div id="dash-announcements-list" class="space-y-3">
                        <!-- Populated via JS -->
                    </div>
                </div>

                <!-- Personal Achievements -->
                <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-100 shadow-soft">
                    <h3 class="font-display font-bold text-xl text-brand-slate mb-6 flex items-center gap-2.5">
                        <span class="w-8 h-8 rounded-lg bg-amber-100 text-amber-600 flex items-center justify-center text-sm">
                            <i class="fas fa-trophy"></i>
                        </span>
                        Capaian Pribadi Anda
                    </h3>

                    <div id="dash-personal-achievements" class="space-y-4">
                        <!-- Populated via JS -->
                    </div>
                </div>

            </div>

        </div>
    </main>
</div>
