---
// Hero Section Component
---

<section id="home" class="relative pt-32 pb-20 lg:pt-44 lg:pb-28 overflow-hidden bg-white">
    <!-- Background Decorative Blobs -->
    <div class="absolute top-0 -left-20 w-96 h-96 bg-brand-warm rounded-full mix-blend-multiply filter blur-3xl opacity-80 animate-blob"></div>
    <div class="absolute top-10 -right-20 w-96 h-96 bg-orange-100 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob" style="animation-delay: 2s;"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid lg:grid-cols-12 gap-12 items-center">

            <!-- Hero Left Column -->
            <div class="lg:col-span-7 text-center lg:text-left">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-warm text-brand-orange font-semibold text-xs sm:text-sm mb-6 border border-brand-light shadow-sm">
                    <span class="w-2.5 h-2.5 rounded-full bg-brand-orange animate-pulse"></span>
                    <span>Official Community Hub & Portal</span>
                </div>

                <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-slate leading-tight mb-6">
                    Selamat Datang di <br>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-orange via-amber-500 to-orange-600">Rayon Cisarua 3</span>
                </h1>

                <p class="text-base sm:text-lg text-brand-muted mb-8 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
                    Wadah pembentukan karakter, kedisiplinan, dan kekeluargaan siswa. Tempat kita tumbuh bersama, mengukir kenangan manis, dan meraih cita-cita.
                </p>

                <!-- CTAs -->
                <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
                    <a href="#students" class="bg-brand-orange hover:bg-brand-hover text-white px-8 py-3.5 rounded-full font-semibold shadow-lg shadow-brand-orange/25 hover:-translate-y-0.5 transition-all text-center flex items-center justify-center gap-2">
                        <span>Jelajahi Anggota Siswa</span>
                        <i class="fas fa-arrow-right text-xs"></i>
                    </a>
                    <a href="#gallery" class="bg-white text-brand-slate border-2 border-slate-200 px-8 py-3.5 rounded-full font-semibold hover:border-brand-orange hover:text-brand-orange hover:bg-brand-warm transition-all text-center flex items-center justify-center gap-2">
                        <i class="fas fa-images text-brand-orange"></i>
                        <span>Lihat Galeri Momen</span>
                    </a>
                </div>

                <!-- Highlight Stats -->
                <div class="mt-12 pt-8 border-t border-slate-100 grid grid-cols-3 gap-4 text-center lg:text-left">
                    <div>
                        <p class="font-display font-extrabold text-2xl lg:text-3xl text-brand-slate">32</p>
                        <p class="text-xs sm:text-sm text-brand-muted font-medium mt-1">Siswa Aktif</p>
                    </div>
                    <div>
                        <p class="font-display font-extrabold text-2xl lg:text-3xl text-brand-orange">100%</p>
                        <p class="text-xs sm:text-sm text-brand-muted font-medium mt-1">Semangat High Character</p>
                    </div>
                    <div>
                        <p class="font-display font-extrabold text-2xl lg:text-3xl text-brand-slate">15+</p>
                        <p class="text-xs sm:text-sm text-brand-muted font-medium mt-1">Penghargaan Rayon</p>
                    </div>
                </div>
            </div>

            <!-- Hero Right Visual -->
            <div class="lg:col-span-5 relative">
                <div class="relative mx-auto w-full max-w-md lg:max-w-none">
                    <!-- Main Photo Frame -->
                    <div class="relative w-full aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl border-4 border-white z-10 bg-slate-100">
                        <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&q=80&w=1000" alt="Kebersamaan Rayon Cisarua 3" class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-700">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
                        <div class="absolute bottom-4 left-4 right-4 text-white">
                            <span class="bg-brand-orange text-xs font-bold px-2.5 py-1 rounded-md uppercase tracking-wider mb-1 inline-block">Kebersamaan</span>
                            <p class="text-sm font-semibold">Kekeluargaan & Semangat Rayon Cisarua 3</p>
                        </div>
                    </div>

                    <!-- Floating Card 1 -->
                    <div class="absolute -top-6 -left-6 bg-white p-4 rounded-2xl shadow-xl border border-orange-100 z-20 animate-float hidden sm:block">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-orange-100 text-brand-orange flex items-center justify-center font-bold text-lg">
                                <i class="fas fa-award"></i>
                            </div>
                            <div>
                                <p class="text-xs text-brand-muted font-medium">Rayon Terdisiplin</p>
                                <p class="text-sm font-display font-bold text-brand-slate">Predikat Kebersihan & Kerapihan</p>
                            </div>
                        </div>
                    </div>

                    <!-- Floating Card 2 -->
                    <div class="absolute -bottom-6 -right-6 bg-white p-4 rounded-2xl shadow-xl border border-orange-100 z-20 animate-float hidden sm:block" style="animation-delay: 2s;">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-brand-warm text-brand-orange flex items-center justify-center font-bold text-lg">
                                <i class="fas fa-user-graduate"></i>
                            </div>
                            <div>
                                <p class="text-xs text-brand-muted font-medium">Pembimbing Rayon</p>
                                <p class="text-sm font-display font-bold text-brand-slate">Mohamad Rizal S.Pd</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
