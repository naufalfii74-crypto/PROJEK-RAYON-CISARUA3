---
import { studentsData } from '../data/siteData';
---

<section id="students" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
            <div>
                <span class="text-brand-orange font-bold uppercase tracking-wider text-xs bg-brand-warm px-3.5 py-1.5 rounded-full border border-brand-light">
                    Data Anggota
                </span>
                <h2 class="font-display text-3xl sm:text-4xl font-extrabold text-brand-slate mt-3">
                    Daftar Siswa Rayon Cisarua 3
                </h2>
                <p class="text-brand-muted mt-1 text-sm sm:text-base">
                    Temukan informasi profil dan peran dari seluruh anggota rayon kami.
                </p>
            </div>

            <!-- Search & Role Filter -->
            <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
                <div class="relative flex-grow sm:w-64">
                    <i class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                    <input type="text" id="student-search-input" placeholder="Cari nama atau NIS..." class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:outline-none focus:border-brand-orange focus:ring-2 focus:ring-brand-orange/20 transition-all">
                </div>

                <select id="student-role-filter" class="px-4 py-2.5 rounded-xl border border-slate-200 text-sm text-brand-slate bg-white focus:outline-none focus:border-brand-orange transition-all cursor-pointer">
                    <option value="ALL">Semua Peran & Angkatan</option>
                    <option value="Pengurus">Pengurus Rayon</option>
                    <option value="Anggota">Anggota Siswa</option>
                    <option value="30">Angkatan 30</option>
                    <option value="31">Angkatan 31</option>
                </select>
            </div>
        </div>

        <!-- Student Grid -->
        <div id="students-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {studentsData.map((student) => (
                <div class="bg-white rounded-2xl p-5 border border-slate-100 shadow-soft hover:shadow-hover-lift hover:-translate-y-1 transition-all duration-300 flex flex-col cursor-pointer" data-student-card data-fullname={student.fullname} data-nis={student.nis} data-officer={student.isOfficer.toString()} data-angkatan={student.angkatan || ''}>
                    <div class="flex items-center gap-4 mb-4">
                        <img src={student.photo} alt={student.fullname} class="w-14 h-14 rounded-full object-cover border-2 border-brand-warm shadow-sm flex-shrink-0">
                        <div class="overflow-hidden">
                            <h4 class="font-display font-bold text-base text-brand-slate truncate">{student.fullname}</h4>
                            <span class="text-xs font-mono font-medium text-brand-muted">NIS: {student.nis}</span>
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <div class="flex items-center gap-1.5 flex-wrap">
                            <span class={`inline-block text-[11px] font-semibold ${student.isOfficer ? 'bg-brand-warm text-brand-orange border border-brand-light' : 'bg-slate-100 text-slate-600'} px-2.5 py-0.5 rounded-full`}>
                                {student.role}
                            </span>
                            {student.angkatan && (
                                <span class="inline-block text-[11px] font-medium bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full border border-slate-200">
                                    Angkatan {student.angkatan}
                                </span>
                            )}
                        </div>
                        <p class="text-xs text-brand-muted font-medium truncate">{student.major}</p>
                    </div>
                </div>
            ))}
        </div>

        <!-- Empty State -->
        <div id="students-empty-state" class="hidden text-center py-16 bg-brand-warm/30 rounded-2xl border border-brand-light">
            <div class="w-16 h-16 bg-orange-100 text-brand-orange rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                <i class="fas fa-user-slash"></i>
            </div>
            <h4 class="font-display font-bold text-lg text-brand-slate">Siswa Tidak Ditemukan</h4>
            <p class="text-brand-muted text-sm mt-1">Coba kata kunci pencarian atau filter yang berbeda.</p>
        </div>

    </div>
</section>
