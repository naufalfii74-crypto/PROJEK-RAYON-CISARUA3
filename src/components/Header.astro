---
// Header / Navigation Component
---

<header class="fixed top-0 left-0 right-0 z-40 transition-all duration-300" id="navbar">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
            <!-- Brand Logo -->
            <a href="#home" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-orange to-brand-amber flex items-center justify-center text-white font-extrabold text-xl shadow-md group-hover:scale-105 transition-transform">
                    RC
                </div>
                <div>
                    <span class="font-display font-extrabold text-xl text-brand-slate tracking-tight block leading-none">
                        Cisarua 3<span class="text-brand-orange">.</span>
                    </span>
                    <span class="text-[10px] font-semibold text-brand-muted uppercase tracking-wider">Rayon Digital Home</span>
                </div>
            </a>

            <!-- Desktop Navigation Links -->
            <nav class="hidden lg:flex space-x-7 items-center text-sm font-medium">
                <a href="#home" class="nav-link text-brand-slate hover:text-brand-orange transition-colors">Beranda</a>
                <a href="#about-rayon" class="nav-link text-brand-slate hover:text-brand-orange transition-colors">Tentang Rayon</a>
                <a href="#mentor" class="nav-link text-brand-slate hover:text-brand-orange transition-colors">Pembimbing</a>
                <a href="#piket" class="nav-link text-brand-slate hover:text-brand-orange transition-colors">Jadwal Piket</a>
                <a href="#students" class="nav-link text-brand-slate hover:text-brand-orange transition-colors">Siswa</a>
                <a href="#gallery" class="nav-link text-brand-slate hover:text-brand-orange transition-colors">Galeri</a>
                <a href="#achievements" class="nav-link text-brand-slate hover:text-brand-orange transition-colors">Prestasi</a>
            </nav>

            <!-- Auth Buttons / User Profile Badge -->
            <div class="hidden lg:flex items-center gap-3" id="nav-auth-container">
                <button id="nav-login-btn" class="flex items-center gap-2 bg-brand-orange hover:bg-brand-hover text-white px-5 py-2.5 rounded-full font-semibold text-sm shadow-md shadow-brand-orange/20 hover:shadow-lg transition-all transform hover:-translate-y-0.5">
                    <i class="fas fa-sign-in-alt text-xs"></i>
                    <span>Login Siswa</span>
                </button>
            </div>

            <!-- Mobile Hamburger Button -->
            <div class="lg:hidden flex items-center gap-2">
                <button id="mobile-login-btn" class="text-xs bg-brand-warm text-brand-orange border border-brand-light font-semibold px-3 py-2 rounded-lg mr-1">
                    Login
                </button>
                <button id="mobile-menu-btn" class="text-brand-slate hover:text-brand-orange p-2 focus:outline-none" aria-label="Toggle Menu">
                    <i class="fas fa-bars text-2xl"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-white transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden flex flex-col pt-20 px-6 shadow-2xl">
        <button id="close-menu-btn" class="absolute top-6 right-6 text-brand-slate p-2 text-2xl hover:text-brand-orange">
            <i class="fas fa-times"></i>
        </button>

        <div class="flex flex-col space-y-5 font-display font-semibold text-lg border-b border-slate-100 pb-8">
            <a href="#home" class="mobile-link text-brand-slate hover:text-brand-orange flex items-center justify-between">
                <span>Beranda</span> <i class="fas fa-chevron-right text-xs opacity-40"></i>
            </a>
            <a href="#about-rayon" class="mobile-link text-brand-slate hover:text-brand-orange flex items-center justify-between">
                <span>Tentang Rayon</span> <i class="fas fa-chevron-right text-xs opacity-40"></i>
            </a>
            <a href="#mentor" class="mobile-link text-brand-slate hover:text-brand-orange flex items-center justify-between">
                <span>Pembimbing Rayon</span> <i class="fas fa-chevron-right text-xs opacity-40"></i>
            </a>
            <a href="#piket" class="mobile-link text-brand-slate hover:text-brand-orange flex items-center justify-between">
                <span>Jadwal Piket</span> <i class="fas fa-chevron-right text-xs opacity-40"></i>
            </a>
            <a href="#students" class="mobile-link text-brand-slate hover:text-brand-orange flex items-center justify-between">
                <span>Data Siswa</span> <i class="fas fa-chevron-right text-xs opacity-40"></i>
            </a>
            <a href="#gallery" class="mobile-link text-brand-slate hover:text-brand-orange flex items-center justify-between">
                <span>Galeri Momen</span> <i class="fas fa-chevron-right text-xs opacity-40"></i>
            </a>
            <a href="#achievements" class="mobile-link text-brand-slate hover:text-brand-orange flex items-center justify-between">
                <span>Prestasi Rayon</span> <i class="fas fa-chevron-right text-xs opacity-40"></i>
            </a>
        </div>

        <div class="pt-6" id="mobile-auth-container">
            <button id="mobile-drawer-login-btn" class="w-full bg-brand-orange text-white py-3.5 rounded-xl font-semibold flex items-center justify-center gap-2 shadow-lg shadow-brand-orange/20">
                <i class="fas fa-user-lock"></i>
                <span>Portal Siswa (Login)</span>
            </button>
        </div>
    </div>
</header>
